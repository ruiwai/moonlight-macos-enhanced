diff --git a/CMakeLists.txt b/CMakeLists.txt
index b14e702..fce05a8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -334,3 +334,32 @@ if (BUILD_TESTING)
   endif()
   add_test(NAME pyrowave-reassembly-golden-tests COMMAND pyrowave-reassembly-golden-tests)
 endif()
+
+# Worker tests include production InputStream.c and stub only transport/clock.
+if(BUILD_TESTING)
+  add_executable(input-stream-policy-test tests/InputStreamPolicyTest.c)
+  target_include_directories(input-stream-policy-test PRIVATE src enet/include)
+  target_compile_definitions(input-stream-policy-test PRIVATE HAS_SOCKLEN_T)
+  add_test(NAME input-stream-policy-test COMMAND input-stream-policy-test)
+  if(UNIX AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
+    find_package(Threads REQUIRED)
+    add_executable(input-stream-worker-test tests/InputStreamWorkerTest.c
+      src/LinkedBlockingQueue.c src/Platform.c)
+    add_executable(linked-blocking-queue-atomic-test tests/LinkedBlockingQueueAtomicTest.c
+      src/LinkedBlockingQueue.c src/Platform.c)
+    foreach(test_target input-stream-worker-test linked-blocking-queue-atomic-test)
+      target_include_directories(${test_target} PRIVATE src enet/include)
+      target_compile_definitions(${test_target} PRIVATE HAS_SOCKLEN_T)
+      target_compile_options(${test_target} PRIVATE -ffunction-sections -fdata-sections
+        -Wall -Wextra -Werror -Wno-unused-parameter)
+      if(APPLE)
+        set_property(TARGET ${test_target} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,-dead_strip")
+      else()
+        set_property(TARGET ${test_target} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--gc-sections")
+      endif()
+      target_link_libraries(${test_target} PRIVATE Threads::Threads)
+      add_test(NAME ${test_target} COMMAND ${test_target})
+      set_tests_properties(${test_target} PROPERTIES TIMEOUT 20)
+    endforeach()
+  endif()
+endif()
diff --git a/src/InputQueueExtensions.h b/src/InputQueueExtensions.h
new file mode 100644
index 0000000..1c04c4a
--- /dev/null
+++ b/src/InputQueueExtensions.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "LinkedBlockingQueue.h"
+
+#define LBQ_MERGED 5
+
+// Callbacks run under the queue mutex; they must not reenter queue APIs.
+// LBQ_MERGED leaves the offered item owned by the caller. Successful eviction
+// transfers ownership of *evictedData to the caller; failed offers retain data.
+typedef bool (*PLBQ_TAIL_MERGE_CALLBACK)(void* tailData, void* offeredData, void* context);
+typedef bool (*PLBQ_EVICTION_PREDICATE)(void* data, void* context);
+typedef bool (*PLBQ_POLL_PREDICATE)(void* data, void* context);
+
+int LbqOfferQueueItemWithTailMerge(PLINKED_BLOCKING_QUEUE queueHead, void* data,
+                                   PLINKED_BLOCKING_QUEUE_ENTRY entry,
+                                   PLBQ_TAIL_MERGE_CALLBACK mergeCallback, void* context);
+int LbqOfferQueueItemWithOldestEviction(PLINKED_BLOCKING_QUEUE queueHead, void* data,
+                                        PLINKED_BLOCKING_QUEUE_ENTRY entry,
+                                        PLBQ_EVICTION_PREDICATE evictionPredicate,
+                                        void* context, void** evictedData);
+int LbqPollQueueElementIf(PLINKED_BLOCKING_QUEUE queueHead,
+                          PLBQ_POLL_PREDICATE predicate,
+                          void* context,
+                          void** data);
