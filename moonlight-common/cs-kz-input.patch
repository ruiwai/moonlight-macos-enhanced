+    CHECK(LiSendKeyboardEventCtx(ctx, 0x41, KEY_ACTION_UP, 0) == 0);
+    CHECK(LiSendMousePositionEventCtx(ctx, 50, 60, 1000, 800) == 0);
+    CHECK(LiSendMousePositionEventCtx(ctx, 70, 80, 1100, 900) == 0);
+    inputSendThreadProc(ctx);
+    CHECK(sentInputCount == 3);
+    CHECK(sentInputs[0].magic == LE32(MOUSE_MOVE_ABS_MAGIC));
+    CHECK(sentInputs[0].deltaX == 30 && sentInputs[0].deltaY == 40);
+    CHECK(sentInputs[0].width == 899 && sentInputs[0].height == 699);
+    CHECK(sentInputs[1].magic == LE32(KEY_UP_EVENT_MAGIC));
+    CHECK(!sentInputs[1].moreData);
+    CHECK(sentInputs[2].magic == LE32(MOUSE_MOVE_ABS_MAGIC));
+    CHECK(sentInputs[2].deltaX == 70 && sentInputs[2].deltaY == 80);
+    CHECK(sentInputs[2].width == 1099 && sentInputs[2].height == 899);
+Exit:
+    initialized = false;
+    cleanupWorkerState();
+    return result;
+}
+
+static int testContextIsolation(void) {
+    static ML_CONNECTION_CONTEXT other;
+    PML_INPUT_STREAM_CONTEXT first = ctx;
+    int result = 0;
+    CHECK(setupWorkerState(TEST_PREQUEUED, 2) == 0);
+    CHECK(LiSendMouseMoveEventCtx(ctx, 12, 3) == 0);
+    CHECK(LiSendMousePositionEventCtx(ctx, 22, 33, 800, 600) == 0);
+    ctx = &other.inputContext;
+    CHECK(setupWorkerState(TEST_PREQUEUED, 2) == 0);
+    ctx->connectionContext = &other;
+    AppVersionQuad[0] = 7;
+    AppVersionQuad[1] = 1;
+    AppVersionQuad[2] = 431;
+    AppVersionQuad[3] = -1;
+    CHECK(LiSendMouseMoveEventCtx(ctx, -8, -9) == 0);
+    CHECK(LiSendMousePositionEventCtx(ctx, 77, 88, 1200, 1000) == 0);
+    ctx = first;
+    inputSendThreadProc(ctx);
+    CHECK(sentInputCount == 2);
+    CHECK(sentInputs[0].deltaX == 12 && sentInputs[0].deltaY == 3);
+    CHECK(sentInputs[1].deltaX == 22 && sentInputs[1].deltaY == 33);
+    CHECK(sentInputs[1].width == 799);
+    ctx = &other.inputContext;
+    sentInputCount = 0;
+    inputSendThreadProc(ctx);
+    CHECK(sentInputCount == 2);
+    CHECK(sentInputs[0].deltaX == -8 && sentInputs[0].deltaY == -9);
+    CHECK(sentInputs[1].deltaX == 77 && sentInputs[1].deltaY == 88);
+    CHECK(sentInputs[1].width == 1199);
+Exit:
+    ctx = &other.inputContext;
+    initialized = false;
+    cleanupWorkerState();
+    ctx = first;
+    initialized = false;
+    cleanupWorkerState();
+    return result;
+}
+
+// Bypass producer compression so this checks the worker's own atomic merge.
+static int queueRawRelative(short x, short y) {
+    PPACKET_HOLDER holder = allocatePacketHolder(ctx, 0);
+    if (holder == NULL) return -1;
+    holder->channelId = CTRL_CHANNEL_MOUSE;
+    holder->enetPacketFlags = ENET_PACKET_FLAG_RELIABLE;
+    holder->packet.mouseMoveRel.header.size = BE32(sizeof(NV_REL_MOUSE_MOVE_PACKET) - 4);
+    holder->packet.mouseMoveRel.header.magic = LE32(MOUSE_MOVE_REL_MAGIC_GEN5);
+    holder->packet.mouseMoveRel.deltaX = BE16(x);
+    holder->packet.mouseMoveRel.deltaY = BE16(y);
+    return LbqOfferQueueItem(&packetQueue, holder, &holder->entry);
+}
+
+static int testWorkerMergeAndSignedLimits(void) {
+    int result = 0;
+    CHECK(setupWorkerState(TEST_PREQUEUED, 4) == 0);
+    CHECK(queueRawRelative(4, 7) == 0);
+    CHECK(queueRawRelative(0, -9) == 0); // vertical reversal is not a boundary
+    CHECK(LiSendKeyboardEventCtx(ctx, 0x41, KEY_ACTION_UP, 0) == 0);
+    CHECK(queueRawRelative(0, INT16_MIN) == 0);
+    CHECK(queueRawRelative(0, -1) == 0); // vertical signed16 underflow boundary
+    inputSendThreadProc(ctx);
+    CHECK(sentInputCount == 4);
+    CHECK(sentInputs[0].deltaX == 4 && sentInputs[0].deltaY == -2);
+    CHECK(!sentInputs[0].moreData && !sentInputs[1].moreData);
+    CHECK(sentInputs[2].deltaY == INT16_MIN && !sentInputs[2].moreData);
+    CHECK(sentInputs[3].deltaY == -1 && !sentInputs[3].moreData);
+    CHECK(sleepCount == 0);
+Exit:
+    initialized = false;
+    cleanupWorkerState();
+    return result;
+}
+
+static int testPenSamplesPreserved(void) {
+    int result = 0;
+    CHECK(setupWorkerState(TEST_PREQUEUED, 4) == 0);
+    // Contact MOVE samples must not collapse; only adjacent matching HOVERs may.
+    for (int i = 0; i < 5; i++) {
+        PPACKET_HOLDER holder = allocatePacketHolder(ctx, 0);
+        CHECK(holder != NULL);
+        memset(holder, 0, sizeof(*holder));
+        holder->channelId = CTRL_CHANNEL_MOUSE;
+        holder->packet.pen.header.size = BE32(sizeof(SS_PEN_PACKET) - 4);
+        holder->packet.pen.header.magic = LE32(SS_PEN_MAGIC);
+        holder->packet.pen.eventType = i < 2 ? LI_TOUCH_EVENT_MOVE : LI_TOUCH_EVENT_HOVER;
+        holder->packet.pen.penButtons = i == 4 ? 1 : 0;
+        CHECK(LbqOfferQueueItem(&packetQueue, holder, &holder->entry) == 0);
+    }
+    inputSendThreadProc(ctx);
+    CHECK(sentInputCount == 4);
+    for (int i = 0; i < 4; i++) CHECK(sentInputs[i].magic == LE32(SS_PEN_MAGIC));
+Exit:
+    initialized = false;
+    cleanupWorkerState();
+    return result;
+}
+
+int main(void) {
+    int result;
+
+    ctx->connectionContext = &testConnection;
+    AppVersionQuad[0] = 7;
+    AppVersionQuad[1] = 1;
+    AppVersionQuad[2] = 431;
+    AppVersionQuad[3] = -1;
+
+    result = testWorkerMergeAndSignedLimits();
+    if (result != 0) return result;
+    result = testPenSamplesPreserved();
+    if (result != 0) return result;
+    result = testAbsoluteSnapshots();
+    if (result != 0) return result;
+    result = testContextIsolation();
+    if (result != 0) return result;
+
+    result = testQueueCompression();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testMouseButtonBarrier();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testKeyboardBarrier();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testWheelBarrier();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testHorizontalReversal();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testArithmeticOverflow();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testContinuousSameDirection();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testSaturatedButtonRelease();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testSaturatedKeyUp();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testSaturatedVerticalWheel();
+    if (result != 0) {
+        return result;
+    }
+
+    result = testSaturatedHorizontalWheel();
+    if (result != 0) {
+        return result;
+    }
+
+    return testSemanticOnlySaturationRejectsWithoutEviction();
+}
diff --git a/tests/LinkedBlockingQueueAtomicTest.c b/tests/LinkedBlockingQueueAtomicTest.c
new file mode 100644
index 0000000..ac6a6bb
--- /dev/null
+++ b/tests/LinkedBlockingQueueAtomicTest.c
@@ -0,0 +1,203 @@
+#include "InputQueueExtensions.h"
+
+#include <errno.h>
+#include <pthread.h>
+
+typedef struct _TEST_ITEM {
+    int value;
+} TEST_ITEM;
+
+typedef enum _PRODUCER_KIND {
+    PRODUCER_TAIL_MERGE,
+    PRODUCER_OLDEST_EVICTION,
+} PRODUCER_KIND;
+
+typedef struct _INTERLEAVING_CONTEXT {
+    LINKED_BLOCKING_QUEUE queue;
+    pthread_mutex_t gateMutex;
+    pthread_cond_t gateCondition;
+    bool predicateEntered;
+    bool producerAttempting;
+    bool releasePredicate;
+    int producerCallbackCount;
+    int consumerResult;
+    int producerResult;
+    void* consumerData;
+    void* evictedData;
+    TEST_ITEM offeredItem;
+    LINKED_BLOCKING_QUEUE_ENTRY offeredEntry;
+    PRODUCER_KIND producerKind;
+} INTERLEAVING_CONTEXT;
+
+#define CHECK(condition) do { if (!(condition)) { fprintf(stderr, "FAIL: %s (line %d)\n", #condition, __LINE__); return EXIT_FAILURE; } } while (0)
+
+static bool classifyAndPause(void* data, void* context) {
+    INTERLEAVING_CONTEXT* test = context;
+    TEST_ITEM* item = data;
+
+    pthread_mutex_lock(&test->gateMutex);
+    test->predicateEntered = true;
+    pthread_cond_broadcast(&test->gateCondition);
+    while (!test->releasePredicate) {
+        pthread_cond_wait(&test->gateCondition, &test->gateMutex);
+    }
+    pthread_mutex_unlock(&test->gateMutex);
+
+    return item->value == 7;
+}
+
+static bool mutateTailIfCalled(void* tailData, void* offeredData, void* context) {
+    INTERLEAVING_CONTEXT* test = context;
+    TEST_ITEM* tail = tailData;
+
+    (void)offeredData;
+    test->producerCallbackCount++;
+    tail->value = 99;
+    return true;
+}
+
+static bool evictAnyItem(void* data, void* context) {
+    INTERLEAVING_CONTEXT* test = context;
+
+    (void)data;
+    test->producerCallbackCount++;
+    return true;
+}
+
+static void* consumerThread(void* context) {
+    INTERLEAVING_CONTEXT* test = context;
+
+    test->consumerResult = LbqPollQueueElementIf(&test->queue,
+                                                 classifyAndPause,
+                                                 test,
+                                                 &test->consumerData);
+    return NULL;
+}
+
+static void* producerThread(void* context) {
+    INTERLEAVING_CONTEXT* test = context;
+
+    pthread_mutex_lock(&test->gateMutex);
+    while (!test->predicateEntered) {
+        pthread_cond_wait(&test->gateCondition, &test->gateMutex);
+    }
+    test->producerAttempting = true;
+    pthread_cond_broadcast(&test->gateCondition);
+    pthread_mutex_unlock(&test->gateMutex);
+
+    if (test->producerKind == PRODUCER_TAIL_MERGE) {
+        test->producerResult = LbqOfferQueueItemWithTailMerge(&test->queue,
+                                                             &test->offeredItem,
+                                                             &test->offeredEntry,
+                                                             mutateTailIfCalled,
+                                                             test);
+    }
+    else {
+        test->producerResult = LbqOfferQueueItemWithOldestEviction(&test->queue,
+                                                                  &test->offeredItem,
+                                                                  &test->offeredEntry,
+                                                                  evictAnyItem,
+                                                                  test,
+                                                                  &test->evictedData);
+    }
+
+    return NULL;
+}
+
+static int runInterleaving(PRODUCER_KIND producerKind) {
+    INTERLEAVING_CONTEXT test = {0};
+    LINKED_BLOCKING_QUEUE_ENTRY candidateEntry;
+    TEST_ITEM candidateItem = {7};
+    pthread_t consumer;
+    pthread_t producer;
+    void* remainingData = NULL;
+
+    test.producerKind = producerKind;
+    test.offeredItem.value = 11;
+
+    CHECK(pthread_mutex_init(&test.gateMutex, NULL) == 0);
+    CHECK(pthread_cond_init(&test.gateCondition, NULL) == 0);
+    CHECK(LbqInitializeLinkedBlockingQueue(&test.queue, 1) == 0);
+    CHECK(LbqOfferQueueItem(&test.queue, &candidateItem, &candidateEntry) == LBQ_SUCCESS);
+
+    CHECK(pthread_create(&consumer, NULL, consumerThread, &test) == 0);
+    CHECK(pthread_create(&producer, NULL, producerThread, &test) == 0);
+
+    pthread_mutex_lock(&test.gateMutex);
+    while (!test.producerAttempting) {
+        pthread_cond_wait(&test.gateCondition, &test.gateMutex);
+    }
+
+    // The classifier is paused while holding the queue mutex, so the producer
+    // cannot enter its merge or eviction callback until removal is complete.
+    CHECK(pthread_mutex_trylock(&test.queue.mutex) == EBUSY);
+    CHECK(test.producerCallbackCount == 0);
+    test.releasePredicate = true;
+    pthread_cond_broadcast(&test.gateCondition);
+    pthread_mutex_unlock(&test.gateMutex);
+
+    CHECK(pthread_join(consumer, NULL) == 0);
+    CHECK(pthread_join(producer, NULL) == 0);
+
+    CHECK(test.consumerResult == LBQ_SUCCESS);
+    CHECK(test.consumerData == &candidateItem);
+    CHECK(candidateItem.value == 7);
+    CHECK(test.producerResult == LBQ_SUCCESS);
+    CHECK(test.producerCallbackCount == 0);
+    CHECK(test.evictedData == NULL);
+
+    CHECK(LbqPollQueueElement(&test.queue, &remainingData) == LBQ_SUCCESS);
+    CHECK(remainingData == &test.offeredItem);
+
+    LbqSignalQueueShutdown(&test.queue);
+    CHECK(LbqDestroyLinkedBlockingQueue(&test.queue) == NULL);
+    CHECK(pthread_cond_destroy(&test.gateCondition) == 0);
+    CHECK(pthread_mutex_destroy(&test.gateMutex) == 0);
+    return 0;
+}
+
+static bool valueIsSeven(void* data, void* context) {
+    (void)context;
+    return ((TEST_ITEM*)data)->value == 7;
+}
+
+static int testQueueEdges(void) {
+    LINKED_BLOCKING_QUEUE queue;
+    LINKED_BLOCKING_QUEUE_ENTRY entries[4];
+    TEST_ITEM items[4] = {{1}, {7}, {7}, {2}};
+    void* data = NULL;
+    void* evicted = NULL;
+    CHECK(LbqInitializeLinkedBlockingQueue(&queue, 3) == 0);
+    for (int i = 0; i < 3; i++)
+        CHECK(LbqOfferQueueItem(&queue, &items[i], &entries[i]) == LBQ_SUCCESS);
+    CHECK(LbqOfferQueueItemWithOldestEviction(&queue, &items[3], &entries[3],
+          valueIsSeven, NULL, &evicted) == LBQ_SUCCESS);
+    CHECK(evicted == &items[1]);
+    CHECK(LbqGetItemCount(&queue) == 3);
+    CHECK(LbqPollQueueElementIf(&queue, valueIsSeven, NULL, &data) == LBQ_NO_ELEMENT);
+    CHECK(LbqPollQueueElement(&queue, &data) == LBQ_SUCCESS && data == &items[0]);
+    CHECK(LbqPollQueueElementIf(&queue, valueIsSeven, NULL, &data) == LBQ_SUCCESS);
+    CHECK(data == &items[2]);
+    CHECK(LbqPollQueueElement(&queue, &data) == LBQ_SUCCESS && data == &items[3]);
+    LbqSignalQueueDrain(&queue);
+    CHECK(LbqOfferQueueItemWithTailMerge(&queue, &items[0], &entries[0],
+          NULL, NULL) == LBQ_INTERRUPTED);
+    CHECK(LbqOfferQueueItemWithOldestEviction(&queue, &items[0], &entries[0],
+          valueIsSeven, NULL, &evicted) == LBQ_INTERRUPTED && evicted == NULL);
+    CHECK(LbqPollQueueElementIf(&queue, valueIsSeven, NULL, &data) == LBQ_INTERRUPTED);
+    CHECK(LbqDestroyLinkedBlockingQueue(&queue) == NULL);
+    return 0;
+}
+
+int main(void) {
+    int result;
+
+    result = testQueueEdges();
+    if (result != 0) return result;
+    result = runInterleaving(PRODUCER_TAIL_MERGE);
+    if (result != 0) {
+        return result;
+    }
+
+    return runInterleaving(PRODUCER_OLDEST_EVICTION);
+}
